<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace>ValheimFortress</RootNamespace>
    <AssemblyName>ValheimFortress</AssemblyName>
    <VALHEIM_INSTALL Condition="'$(VALHEIM_INSTALL)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">$(HOME)/Library/Application Support/Steam/steamapps/common/Valheim</VALHEIM_INSTALL>
    <VALHEIM_INSTALL Condition="'$(VALHEIM_INSTALL)' == '' and '$(OS)' == 'Windows_NT'">C:/Program Files (x86)/Steam/steamapps/common/Valheim</VALHEIM_INSTALL>
    <VALHEIM_INSTALL Condition="'$(VALHEIM_INSTALL)' == ''">$(HOME)/.steam/steam/steamapps/common/Valheim</VALHEIM_INSTALL>
    <VALHEIM_MANAGED Condition="'$(VALHEIM_MANAGED)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">$(VALHEIM_INSTALL)/Valheim.app/Contents/Resources/Data/Managed</VALHEIM_MANAGED>
    <VALHEIM_MANAGED Condition="'$(VALHEIM_MANAGED)' == ''">$(VALHEIM_INSTALL)/valheim_Data/Managed</VALHEIM_MANAGED>
    <PUBLICIZED_PATH Condition="'$(PUBLICIZED_PATH)' == ''">$(VALHEIM_MANAGED)/publicized_assemblies</PUBLICIZED_PATH>
    <BEPINEX_CORE Condition="'$(BEPINEX_CORE)' == ''">$(BEPINEX_PATH)/core</BEPINEX_CORE>
  </PropertyGroup>
  <Import Project="Environment.props" Condition="Exists('Environment.props')" />
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="HarmonyX" Version="2.10.2" />
    <PackageReference Include="JotunnLib" Version="2.26.1" ExcludeAssets="build;buildTransitive" />
    <PackageReference Include="Mono.Cecil" Version="0.11.5" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <Reference Include="BepInEx" HintPath="$(BEPINEX_CORE)/BepInEx.dll" Private="false" />
    <Reference Include="$(VALHEIM_MANAGED)/UnityEngine*.dll" Private="false" />
    <Reference Include="$(VALHEIM_MANAGED)/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(PUBLICIZED_PATH)/*_publicized.dll" Private="false" />
    <EmbeddedResource Include="AssetsEmbedded/vfbundle" />
    <EmbeddedResource Include="Localizations/*.json" />
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(PUBLICIZED_PATH)/assembly_valheim_publicized.dll')" Text="Set PUBLICIZED_PATH to the publicized assemblies for your Valheim installation." />
    <Error Condition="!Exists('$(BEPINEX_CORE)/BepInEx.dll')" Text="Set BEPINEX_CORE to your BepInEx core directory." />
  </Target>
</Project>
